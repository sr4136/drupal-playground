{#
/**
 * @file
 * Theme override for the Further Reading Item (Paragraphs component).
 */
#}

<article{{ attributes.addClass('paragraph', 'paragraph--type--further-reading') }}>
  {% if content.field_content %}
    <div class="paragraph__content-reference">
      {{ content.field_content }}
    </div>
  {% endif %}

  {% if content.field_description %}
    <div class="paragraph__description">
      {{ content.field_description }}
    </div>
  {% endif %}
</article>